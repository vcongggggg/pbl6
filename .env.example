# ==============================================================================
# PBL6 — Web API Security Platform Configuration Template (Blue Team v2.0)
# Copy this file to .env and adjust values for local or Docker deployment.
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security & Admin Authentication
# Generate strong key via: openssl rand -hex 32
# In production (APP_ENV=production), this key is mandatory and default values are rejected.
ADMIN_API_KEY=dev-admin-secret-key-change-me

# Database Configuration (SQLite WAL)
DATABASE_URL=sqlite:///./data/waf_security.db

# Target Web API to Protect (Docker: http://vulnerable-api:5000 | Local: http://127.0.0.1:5000)
TARGET_API_URL=http://vulnerable-api:5000

# WAF Operating Modes: OFF | MONITOR_ONLY | ACTIVE_BLOCKING
WAF_MODE=ACTIVE_BLOCKING

# Defense Engine Feature Toggles (Blue Team v2.0)
ML_ENABLED=true
ANOMALY_ENABLED=true
RATE_LIMIT_ENABLED=true

# Rate Limiting & Risk Thresholds (0 - 100 scale)
RATE_LIMIT_PER_MINUTE=60
RISK_BLOCK_THRESHOLD=80
RISK_RATE_LIMIT_THRESHOLD=60

# Frontend Dashboard Server-Side BFF Configuration (Zero Client Secret Exposure)
BACKEND_URL=http://gateway:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
