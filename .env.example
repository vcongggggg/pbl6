# ==============================================================================
# PBL6 — Web API Security Platform Configuration Template
# Copy this file to .env and adjust values for local development.
# DO NOT COMMIT ACTUAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Security & Admin Authentication
# Change this secret key in production/deployment environments
ADMIN_API_KEY=dev-admin-secret-key-change-me

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./data/waf_security.db

# Target Web API to Protect (Local Lab Container)
TARGET_API_URL=http://juice-shop:3000

# WAF Operating Modes: OFF | MONITOR_ONLY | ACTIVE_BLOCKING | HYBRID
WAF_MODE=MONITOR_ONLY

# Module Feature Toggles (Reserved for future phases)
ML_ENABLED=false
ANOMALY_ENABLED=false
RATE_LIMIT_ENABLED=false

# Rate Limiting & Risk Thresholds (Future Phases)
RATE_LIMIT_PER_MINUTE=60
RISK_BLOCK_THRESHOLD=80
RISK_RATE_LIMIT_THRESHOLD=60

# Frontend Dashboard Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
