{
  "info": {
    "name": "PBL6 WAF API Gateway - Security Verification Collection",
    "description": "Comprehensive security testing collection for PBL6 Bookie Bookstore API Gateway (OWASP Top 10 Web & API Security).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
